{
  "name": "game3",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5190 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-packager . game3 --platform=win32 --arch=x64 --out=release --overwrite --ignore=^/src --ignore=^/public --ignore=^/release --ignore=^/node_modules --ignore=^/tools"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "vite": "^8.3.6"
  }
}